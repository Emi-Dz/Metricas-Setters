# =============================================================================
# Variables de entorno — Metricas Setters
# =============================================================================
# Copiá este archivo a `.env.local` y completá los valores reales.
# `.env.local` está en .gitignore: NUNCA se commitea.
#
# En producción estas variables se cargan desde:
#   Vercel → Project Settings → Environment Variables
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — públicas (se inyectan en el bundle del navegador)
# -----------------------------------------------------------------------------
# Todo lo que empieza con VITE_ queda EMBEBIDO en el JS que se sirve al cliente.
# Es visible para cualquier visitante. Solo poner acá claves diseñadas para ser
# públicas (la anon key lo es: está protegida por las policies de RLS).

# URL del proyecto. Formato: https://<project-ref>.supabase.co
# Dónde: Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima (pública, sujeta a RLS). Es la que usa el login y las lecturas.
# Dónde: Supabase → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<...>


# -----------------------------------------------------------------------------
# Supabase — service_role  ⚠️  LEER ANTES DE USAR
# -----------------------------------------------------------------------------
# La service_role key SALTEA RLS por completo: lectura y escritura total sobre
# toda la base, sin restricciones de usuario.
#
# Hoy se consume desde src/lib/adminServiceClient.js, que es código de cliente.
# Al estar prefijada con VITE_, Vite la escribe literal dentro del bundle:
# queda legible en el JS público del deploy. Cualquier visitante la puede
# extraer del bundle y usarla contra la API de Supabase.
#
# La usa para: deleteUser y updateUserById (cambio de password) del panel admin.
#
# Arreglo correcto (pendiente): mover esas dos operaciones a una función del
# servidor — Vercel Serverless Function en /api, o Supabase Edge Function — que
# valide que quien llama es admin y recién ahí use la key. La key pasa a ser
# SUPABASE_SERVICE_ROLE_KEY (sin VITE_) y deja de viajar al navegador.
VITE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<...>


# -----------------------------------------------------------------------------
# Supabase — conexión directa a Postgres (NO la usa la app)
# -----------------------------------------------------------------------------
# Solo para psql / migraciones / Supabase CLI desde tu máquina.
# No la referencia ningún archivo de src/. Nunca prefijarla con VITE_.
# Dónde: Supabase → Project Settings → Database → Connection string
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# n8n MCP (solo entorno local de Claude Code, no es parte del build)
# -----------------------------------------------------------------------------
# Se configuran en .mcp.json — ver .mcp.json.example.
# .mcp.json ahora está en .gitignore. Si lo editás, no lo commitees.
